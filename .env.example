# Copy to .env in the repository root, both on your machine and on the server. Variables already set in the shell
# take precedence. Optional overrides and their defaults: docs/DEVELOPMENT.md and docs/OPERATIONS.md.

# The gather model and ingest analysis use DeepSeek, the final model uses Vertex AI. DB_NAME defaults to DB; on your
# machine DB_HOST and DB_PORT default to 127.0.0.1 and 5555, the SSH tunnel.
DB_USER=
DB_PASS=
DEEPSEEK_API_KEY=
VERTEX_PROJECT=
# Path of the Vertex service-account JSON on this host; on the server compose mounts it into bot and api.
GOOGLE_APPLICATION_CREDENTIALS=
JINA_API_KEY=

# Only when this host cannot reach DeepSeek, Google or Jina directly, e.g. http://127.0.0.1:7890
HTTP_PROXY=
HTTPS_PROXY=

# Server only: uncomment and fill in on the server.
# Host port of the postgres container.
# DB_PORT=5432
# TELEGRAM_BOT_TOKEN=
# Comma-separated Telegram user IDs allowed to run /settings and /quota.
# TELEGRAM_ADMIN_IDS=
# The frontend origin allowed by CORS, and the public API address used in subscription approval links.
# CORS_ORIGINS=
# API_BASE_URL=
# Signs approval links: python -c "import secrets; print(secrets.token_urlsafe(32))"
# APPROVE_LINK_SECRET=
# Mail goes through smtp.gmail.com:587; subscription approvals and ingest alerts go to ADMIN_EMAIL.
# SMTP_USER=
# SMTP_PASS=
# ADMIN_EMAIL=
# Trace dashboard access token.
# TRACE_DASHBOARD_TOKEN=
